# ---------------------------------------------------------------------------
# Everything below is OPTIONAL.
#
# The evaluator runs the full demo with no configuration at all: the default
# provider replays recorded model responses, and the default judge is a
# deterministic local heuristic. Copy this file to .env.local only when you
# want to evaluate against a live model.
# ---------------------------------------------------------------------------

# Required only for --provider anthropic and --judge llm.
# ANTHROPIC_API_KEY=sk-ant-...

# Where runs are stored. Defaults to ./.data (gitignored).
# In Docker this is set to /data and backed by a volume.
# AWE_DATA_DIR=./.data

# Where datasets are loaded from. Defaults to ./examples.
# AWE_EXAMPLES_DIR=./examples

# Print stack traces from the CLI.
# AWE_DEBUG=1
